<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<NoWarn>VSTHRD200</NoWarn>
		<!-- ClickHouse.Driver 1.2.0 references Microsoft.Extensions.* 10.x for its net6.0 target -->
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<Description>Writing objects to ClickHouse over HTTP: ClickHouse.Driver as transport, ClickHouse Native format on the wire. Keeps the columnar ArrayPool-based write path of SharpJuice.ClickHouse, so Array and Nested columns are written without per-value boxing.</Description>
		<PackageTags>clickhouse;bulk;objects;writer;insert;http;native;clickhouse-driver</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClickHouse.Driver" Version="1.2.0" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpJuice.ClickHouse\SharpJuice.ClickHouse.csproj" />
	</ItemGroup>

</Project>
